# Optional. Postgres connection string for lead capture (Neon works well on Vercel).
# Without it the site still works — leads are written to the function log instead of a database.
DATABASE_URL=

# Optional. Stripe Payment Link for the Starter Report.
# Create it at dashboard.stripe.com → Payment Links, set the success URL to
# https://<your-domain>/report?purchased=1, then paste the link here.
# While empty, every purchase CTA stays a waitlist signup.
VITE_STRIPE_PAYMENT_LINK=
